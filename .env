# ─────────────────────────────────────────────────────────────
#  Environment Configuration — Analytics Backend
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Analytics AI Backend"
DEBUG=true
LOG_LEVEL=INFO

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_SQL_MODEL=gpt-4o               # For SQL generation (Node 4)
LLM_INTENT_MODEL=gpt-4o-mini       # For intent classification (Node 1)
LLM_TEMPERATURE=0.0                # Always 0 for SQL — deterministic output

# ── Anthropic (Optional alternative LLM) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── SQL Server (Business Data — READ ONLY) ───────────────────
SQLSERVER_SERVER=DESKTOP-7EP38AQ\UDAY
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SHIFADBLATEST
SQLSERVER_USER=vanna_ro
SQLSERVER_PASSWORD=P@ssw0rd
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_POOL_SIZE=20
SQLSERVER_MAX_OVERFLOW=10
SQLSERVER_QUERY_TIMEOUT=30        # Seconds — hard cap per query

# ── PostgreSQL (Internal Metadata: sessions, history, users) ──
POSTGRES_URL=postgresql+asyncpg://user:password@localhost:5432/analytics_meta

# ── Redis (Cache: query results, prompt cache, Celery) ────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300             # 5 minutes default result cache

# ── Qdrant (Vector DB: schema + semantic embeddings) ──────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                   # Leave empty for local dev
QDRANT_COLLECTION_SCHEMA=schema_embeddings
QDRANT_COLLECTION_METRICS=metric_definitions

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Semantic Layer ────────────────────────────────────────────
SEMANTIC_YAML_DIR=./semantic       # Path to YAML definitions
INCLUDED_TABLES=                   # Optional: comma-separated list of tables to learn (e.g. "Employees,Departments")
MAX_TABLES_IN_CONTEXT=12          # Max tables fed to LLM per query
TOP_K_RETRIEVAL=30                # Broad retrieval before reranking
TOP_K_AFTER_RERANK=8              # Final context after reranker

# ── Agent Settings ────────────────────────────────────────────
MAX_SQL_RETRIES=3                 # Self-correction max attempts
MAX_RESULT_ROWS=1000              # Hard cap on returned rows
CLARIFICATION_TIMEOUT_SECONDS=120 # How long to wait for user reply
