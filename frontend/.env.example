# FastAPI backend used by the dev proxy (vite.config.js)
VITE_BACKEND_URL=http://localhost:8000

# Optional: full API origin for production builds served from another host.
# Leave empty when the frontend is served from the same origin as the API.
VITE_API_BASE_URL=

# Optional: ISO currency code for revenue KPIs (e.g. AED, USD, INR).
# Leave empty to show plain numbers.
VITE_CURRENCY=
